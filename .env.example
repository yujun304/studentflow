APP_ENV=development
DATABASE_URL=postgresql+asyncpg://studentflow:studentflow@localhost:5432/studentflow
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:5173
COMPOSE_FRONTEND_ORIGIN=http://localhost:8081,https://your-tunnel.trycloudflare.com
COMPOSE_FRONTEND_PORT=8081
STORAGE_ROOT=.data/uploads
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=20971520
DEFAULT_TIMEZONE=Asia/Seoul
VAPID_PRIVATE_KEY=/run/secrets/studentflow-vapid/private_key.pem
VAPID_SUBJECT=mailto:admin@example.com
