APP_ENV=development
DATABASE_URL=postgresql+asyncpg://studentflow:studentflow@localhost:5432/studentflow
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:5173
COMPOSE_FRONTEND_ORIGIN=http://localhost:8081,https://your-tunnel.trycloudflare.com
COMPOSE_COOKIE_SECURE=false
COMPOSE_FRONTEND_PORT=8081
STORAGE_ROOT=.data/uploads
STORAGE_BACKEND=local
MAX_UPLOAD_BYTES=104857600
DEFAULT_TIMEZONE=Asia/Seoul
VAPID_PRIVATE_KEY=/run/secrets/studentflow-vapid/private_key.pem
VAPID_SUBJECT=mailto:admin@example.com
PROPOSAL_AI_API_KEY=
PROPOSAL_AI_ENABLED=false
PROPOSAL_AI_BASE_URL=https://api.openai.com/v1
PROPOSAL_AI_MODEL=gpt-5-mini
PROPOSAL_TRANSCRIPTION_PROVIDER=local
PROPOSAL_LOCAL_WHISPER_MODEL=small
PROPOSAL_LOCAL_WHISPER_DEVICE=cpu
PROPOSAL_LOCAL_WHISPER_COMPUTE_TYPE=int8
PROPOSAL_LOCAL_WHISPER_CACHE_DIR=.data/whisper-models
PROPOSAL_LOCAL_WHISPER_CPU_THREADS=4
PROPOSAL_TRANSCRIPTION_MODEL=whisper-1
PROPOSAL_TRANSCRIPTION_LANGUAGE=ko
PROPOSAL_TRANSCRIPTION_API_KEY=
PROPOSAL_TRANSCRIPTION_BASE_URL=
PROPOSAL_AI_TIMEOUT_SECONDS=120
PROPOSAL_TRANSCRIPT_MAX_CHARS=100000
PROPOSAL_AGENDA_RECOMMENDATION_THRESHOLD=10
PROPOSAL_REQUIRED_FEEDBACK_RECOMMENDATION_THRESHOLD=13
PROPOSAL_SUMMARY_MAX_ITEMS=8
PROPOSAL_AUDIO_MAX_BYTES=104857600
PROPOSAL_TRANSCRIPTION_CHUNK_MAX_BYTES=25165824
PROPOSAL_AUDIO_EXTENSIONS=flac,mp3,mp4,mpeg,mpga,m4a,ogg,wav,webm
